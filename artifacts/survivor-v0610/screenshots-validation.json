{
  "stage": "ai-image-validate",
  "rule": {
    "id": "screenshot",
    "label": "gameplay screenshot",
    "generation_mode": "source_edit_only",
    "source_requirement": "actual game capture supplied by the user or captured from the running game",
    "model_operations": [
      "crop",
      "resize",
      "format_conversion",
      "compression"
    ],
    "reference_rules": [
      "use the supplied real game capture as the source image",
      "do not use text-to-image or image-to-image generation to create new gameplay content"
    ],
    "formats": [
      "jpg",
      "png"
    ],
    "tolerance": 0.01,
    "max_file_size": 4194304,
    "count_range": {
      "min": 3
    },
    "dimensions": [
      {
        "min_width": 1280,
        "min_height": 720,
        "aspect_range": [
          1.6,
          2.6666666667
        ]
      },
      {
        "min_width": 720,
        "min_height": 1280,
        "aspect_range": [
          0.375,
          0.625
        ]
      }
    ],
    "consistent_aspect_ratio": true,
    "content_constraints": [
      "all screenshots must use the same aspect ratio as the first screenshot",
      "must originate from actual in-game screens",
      "the model must not invent gameplay scenes, UI, levels, or game states",
      "the model may only crop, resize, convert format, or compress the supplied game capture"
    ],
    "prompt_rules": [
      "preserve the actual game screen and its real gameplay state",
      "only perform the listed source-preserving operations"
    ],
    "forbidden_elements": [
      "invented gameplay",
      "invented UI, levels, characters, items, or game states",
      "new scene redraw or visual repaint"
    ],
    "negative_terms": [
      "watermark",
      "blurry",
      "empty scene",
      "malformed UI text",
      "invented gameplay",
      "new game state"
    ]
  },
  "input": "releases/survivor-v0610-private/selected-screenshots",
  "valid": true,
  "manual_checks": [
    "all screenshots must use the same aspect ratio as the first screenshot",
    "must originate from actual in-game screens",
    "the model must not invent gameplay scenes, UI, levels, or game states",
