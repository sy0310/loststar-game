{
  "name": "loststar-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "capture": "node scripts/capture.mjs",
    "check:assets": "python3 scripts/validate_design_assets.py",
    "check": "npm run check:assets && npm run test:coverage && npm run build && npm run test:e2e",
    "assets:export": "node scripts/export_assets.mjs",
    "report": "node scripts/report.mjs",
    "capture:review": "node scripts/capture_review.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
